# Secrets — never commit these.
# .env holds the database password. .env.example is the safe template and IS committed.
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
dist/
build/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Claude Code machine-local config (contains local permissions, not shareable)
.claude/settings.local.json
.claude/settings.json

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
