# Copy to .env and fill in real values. .env is gitignored and must stay that way.

PORT=3000

# Where the frontend runs — CORS only allows this origin
FRONTEND_ORIGIN=http://localhost:5173

DB_HOST=localhost
# note: 5433, not the usual 5432 — PostgreSQL 18 sits on the second port
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=pokemon_app
